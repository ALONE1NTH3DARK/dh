<FilesMatch "^(telegram-config|telegram-config\.example|admin-config|admin-config\.example)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Каталог lib/ содержит только подключаемый код, напрямую он не вызывается
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
